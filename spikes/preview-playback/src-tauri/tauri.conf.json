{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuaide Preview Spike",
  "version": "0.1.0",
  "identifier": "com.kuaide.preview-spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kuaide preview spike",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' media: http://media.localhost http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
